{
  "id": "ags_control",
  "title": "AGS Control",
  "description": "Active grille shutters (radiator shutters) for show use at standstill: Open, Closed or OEM via the DME. Driving off hands back to OEM. Ships disarmed (simulated).",
  "version": "0.4.0",
  "vendor": "custom",
  "loggingId": "OAG1",
  "iconGlyph": "AGS",
